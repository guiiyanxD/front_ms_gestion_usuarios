{
  "name": "estadisticas",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/estadisticas/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/estadisticas",
        "index": "apps/estadisticas/src/index.html",
        "main": "apps/estadisticas/src/main.ts",
        "tsConfig": "apps/estadisticas/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/estadisticas/public"
          }
        ],
        "styles": ["apps/estadisticas/src/styles.css"],
        "customWebpackConfig": {
          "path": "apps/estadisticas/webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/estadisticas/src/environments/environment.ts",
              "with": "apps/estadisticas/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" },
            { "type": "anyComponentStyle", "maximumWarning": "4kb", "maximumError": "8kb" }
          ],
          "outputHashing": "all",
          "customWebpackConfig": {
            "path": "apps/estadisticas/webpack.prod.config.ts"
          }
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "options": {
        "port": 4206,
        "publicHost": "http://localhost:4206"
      },
      "configurations": {
        "production": { "buildTarget": "estadisticas:build:production" },
        "development": { "buildTarget": "estadisticas:build:development" }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": { "buildTarget": "estadisticas:build" }
    },
    "lint": { "executor": "@nx/eslint:lint" },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": { "reportsDirectory": "coverage/apps/estadisticas" }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "estadisticas:build",
        "port": 4206,
        "watch": false
      },
      "configurations": {
        "development": { "buildTarget": "estadisticas:build:development" },
        "production": { "buildTarget": "estadisticas:build:production" }
      }
    }
  }
}
